# SellerMetrics - Environment variables (EXAMPLE / TEMPLATE)
# ---------------------------------------------------------------
# These are the variables the backend reads (see backend/app/config.py).
# Copy this file to  backend/.env  and fill in your own values:
#
#     Windows:      copy .env.example backend\.env
#     macOS/Linux:  cp .env.example backend/.env
#
# NEVER commit your real backend/.env - it contains your database password
# and JWT secret. It is already listed in .gitignore.

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sellermetrics
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password

# --- Security ---
# Use a long, random string for SECRET_KEY in any real deployment.
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
